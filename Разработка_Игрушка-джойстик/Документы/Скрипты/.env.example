# Образец. Скопируйте этот файл в .env (в этой же папке) и заполните.
# .env в git не попадает. Данные — личный кабинет Рег.ру → услуга хостинга → вкладка «Доступы».

# Адрес сервера: IP из вкладки «Доступы» (или имя вида serverXX.hosting.reg.ru)
SFTP_HOST=
SFTP_PORT=22
# Логин вида u1234567
SFTP_USER=
# Пароль SSH/SFTP (из вкладки «Доступы»)
SFTP_PASSWORD=
# Папка сайта на сервере (в ispmanager обычно www/<домен>), можно полным путём
SFTP_REMOTE_DIR=www/example.ru
# Адрес сайта — только для вывода в конце (необязательно)
SITE_URL=https://example.ru

# GigaChat API — для скрипта картинок gigachat_img.py (рисует встроенный Kandinsky).
# «Ключ авторизации» из кабинета developers.sber.ru. Можно не писать сюда, а хранить
# в переменной пользователя Windows GIGACHAT_AUTH_KEY — скрипт найдёт её сам.
GIGACHAT_AUTH_KEY=
# Для физлица — GIGACHAT_API_PERS, для ИП/юрлица — GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
